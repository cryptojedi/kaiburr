export fn sample_f(reg u64 n, reg u64 buf) -> reg u64 {
  reg u64 i;
  reg u64 bitpos;
  reg u64 bytepos;
  reg u64 a0;
  reg u64 an1;
  reg u64 bit;
  reg u64 all1;
  reg u64 b;
  reg u64 mask;
  reg u64 sign;
  reg u64 magnitude;
  reg u64 result;
  reg u64 n_minus_1;
  reg u64 addr;

  bytepos = 0;
  bitpos = 0;
  mask = 1;
  all1 = 1;

  addr = bytepos;
  addr *= 8;
  addr += buf;
  b = [addr];
  a0 = b;
  a0 &= mask;
  mask += mask;
  bitpos += 1;
  if (bitpos == 64) { bitpos = 0; bytepos += 1; mask = 1; }

  i = 1;
  n_minus_1 = n;
  n_minus_1 -= 1;
  while (i < n_minus_1) {
    addr = bytepos;
    addr *= 8;
    addr += buf;
    b = [addr];
    bit = b;
    bit &= mask;
    mask += mask;
    bitpos += 1;
    if (bitpos == 64) { bitpos = 0; bytepos += 1; mask = 1; }
    if (bit != 0) { all1 = 0; }
    i += 1;
  }

  addr = bytepos;
  addr *= 8;
  addr += buf;
  b = [addr];
  an1 = b;
  an1 &= mask;

  sign = an1;
  sign += sign;
  sign -= 1;
  magnitude = 1;
  magnitude -= a0;
  bit = all1;
  bit += bit;
  magnitude += bit;
  result = sign;
  result *= magnitude;

  return result;
}